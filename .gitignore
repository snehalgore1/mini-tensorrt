build/
build-*/
cmake-build-*/
.cache/
compile_commands.json

# python
__pycache__/
*.pyc
.venv/
venv/

# generated models and fixtures are regenerable, but keep goldens small and committed
models/*.bin
models/*.onnx
!models/goldens/
# ...except the small model fixtures: committed so the C++ test suite needs no Python (D8)
!models/mlp.bin
!models/transformer.bin
# The GPT-2-scale block is large (~57 MB weights, ~MB goldens): regenerate, don't commit.
models/gpt2_block.json
models/goldens/gpt2_*.npy
# Real GPT-2 124M (~500 MB weights + large logit goldens): regenerate, don't commit.
models/gpt2_124m.json
models/goldens/gpt2_124m_*.npy

# profiling / benchmark output (regenerable)
*.trace.json
gemm_results.json
perf.data*
*.dSYM/

# editors
.vscode/
.idea/
.DS_Store
